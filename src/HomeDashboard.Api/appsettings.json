{
  "AllowedHosts": "*",
  "Security": {
    "DashboardApiKey": "change-me-dashboard-key",
    "AgentApiKey": "change-me-agent-key"
  },
  "Dashboard": {
    "DefaultAgentId": "server-pc",
    "Services": [
      {
        "Id": "plex",
        "Name": "Plex",
        "Description": "Media server",
        "Url": "http://server-pc:32400/web",
        "HealthUrl": "http://server-pc:32400/identity",
        "RestartEnabled": false
      },
      {
        "Id": "qbittorrent",
        "Name": "qBittorrent",
        "Description": "Download client",
        "Url": "http://server-pc:8080",
        "HealthUrl": "http://server-pc:8080",
        "RestartEnabled": false
      },
      {
        "Id": "game-server",
        "Name": "Game Server",
        "Description": "Reserved card for a LAN game server",
        "Url": null,
        "HealthUrl": null,
        "RestartEnabled": false
      }
    ],
    "NewsFeeds": [
      {
        "Name": "Ars Technica",
        "Url": "https://feeds.arstechnica.com/arstechnica/index"
      },
      {
        "Name": "The Verge",
        "Url": "https://www.theverge.com/rss/index.xml"
      }
    ]
  }
}
